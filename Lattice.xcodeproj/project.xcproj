{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/christianselig/TinyStorage.git",
      "version": {
        "up-to-next-major-version": "2.0.2",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/m1guelpf/NavigationKit.git",
      "version": {
        "branch": "main",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/p-x9/ObfuscateMacro.git",
      "version": {
        "up-to-next-major-version": "0.13.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/kean/Nuke",
      "version": {
        "up-to-next-major-version": "12.8.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/sqlite-data",
      "version": {
        "up-to-next-major-version": "1.12.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-dependencies/",
      "version": {
        "up-to-next-major-version": "1.10.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-custom-dump",
      "version": {
        "up-to-next-major-version": "1.4.1",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-debug-snapshots",
      "version": {
        "up-to-next-major-version": "0.5.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/pointfreeco/swift-snapshot-testing",
      "version": {
        "up-to-next-major-version": "1.18.9",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/getsentry/sentry-cocoa.git",
      "version": {
        "up-to-next-major-version": "9.4.0",
      },
    },
  ],
  "files": [
    {
      "kind": "folder",
      "path": "src",
      "target-membership": [
        "Lattice",
        "LatticeDev",
      ],
      "membership-exceptions": [
        {
          "target": "Lattice",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "LatticeDev",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "tests", "target-membership": [ "LatticeTests" ] },
    { "kind": "group", "name": "Frameworks" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Lattice.app", "id": "C02BFFA42F1A04EE00169A69", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/LatticeDev.app", "id": "C0DEF00D2F2A000000000001", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/LatticeTests.xctest", "id": "C033A4402F2FE0B100717CFE", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
